# ==========================================
# LMS Backend Environment Configuration
# ==========================================

# 1. Database Connection URL:
# ------------------------------------------
# Local SQLite (Default):
DATABASE_URL=sqlite:///./lms.db

# Neon Serverless PostgreSQL:
# DATABASE_URL=postgresql://neondb_owner:<password>@<endpoint>.neon.tech/neondb?sslmode=require

# Supabase PostgreSQL:
# (Note: Use Session pooler / Port 5432 or Transaction pooler / Port 6543)
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# 2. Authentication & Security:
# ------------------------------------------
# In production, generate a secure random 64-character secret key:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=lms-production-secure-jwt-secret-key-super-secure

# 3. CORS Allowed Origins:
# ------------------------------------------
# Comma-separated list of client domains allowed to communicate with this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# 4. Database Safety Flags:
# ------------------------------------------
# Set to 'true' if you want init_db.py to allow resetting a PostgreSQL database without passing '--force'
ALLOW_DB_RESET=false
